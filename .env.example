# Set these in your shell or copy to .env at the project root.
NUSCENES_ROOT=/absolute/path/to/nuscenes
CVAT_URL=http://localhost:8080
CVAT_TOKEN=
CVAT_AUTH_SCHEME=Token
# Alternative to token authentication:
CVAT_USERNAME=
CVAT_PASSWORD=
# For tasks in an organization; leave blank for personal tasks.
CVAT_ORG=
